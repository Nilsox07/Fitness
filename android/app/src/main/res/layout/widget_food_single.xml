<?xml version="1.0" encoding="utf-8"?>
<!-- Essen eintragen (2×1): ein großer Knopf, öffnet die Auswahl Foto/Sagen/Scannen/Suchen -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetFb.Hero"
    android:contentDescription="Essen eintragen">

    <ImageView android:id="@+id/art" style="@style/WidgetFb.Art" />

    <include
        android:id="@+id/empty"
        layout="@layout/widget_empty_hero"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_action_primary">

            <ImageView
                android:id="@+id/plus"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_plus"
                android:tint="#9F1239" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                style="@style/WidgetFb.HeroTitle"
                android:maxLines="1"
                android:text="Frühstück"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/kcal"
                style="@style/WidgetFb.HeroBody"
                android:text="eintragen"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
