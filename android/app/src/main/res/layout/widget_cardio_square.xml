<?xml version="1.0" encoding="utf-8"?>
<!-- Ausdauer (2×2): km dieser Woche, Balken je Tag, nächste Einheit -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetFb.Hero">

    <ImageView android:id="@+id/art" style="@style/WidgetFb.Art" />

    <include
        android:id="@+id/empty"
        layout="@layout/widget_empty_hero"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        style="@style/WidgetFb.HeroContent"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/overline"
            style="@style/WidgetFb.HeroOverline"
            android:text="Ausdauer · Sa" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/km"
                style="@style/WidgetFb.HeroNumber"
                android:text="18,4" />

            <TextView
                android:id="@+id/unit"
                style="@style/WidgetFb.HeroBody"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="4dp"
                android:text="km"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/sub"
            style="@style/WidgetFb.HeroBody"
            android:textSize="11sp"
            android:text="3 Einheiten · 2:35 h" />

        <FrameLayout style="@style/WidgetFb.Fill" />

        <ImageView
            android:id="@+id/week"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <TextView
            android:id="@+id/plan"
            style="@style/WidgetFb.HeroBody"
            android:layout_marginTop="4dp"
            android:textColor="@color/hero_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="Heute: 30 min locker" />
    </LinearLayout>
</FrameLayout>
