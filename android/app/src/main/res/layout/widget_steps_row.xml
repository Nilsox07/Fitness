<?xml version="1.0" encoding="utf-8"?>
<!-- Schritte flach (2×1): kleiner Ring, Zahl -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetFb.Card">

    <ImageView android:id="@+id/glow" style="@style/WidgetFb.Glow" />

    <include
        android:id="@+id/empty"
        layout="@layout/widget_empty"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        style="@style/WidgetFb.Content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView android:id="@+id/ring" style="@style/WidgetFb.Ring" />

            <TextView
                android:id="@+id/pct"
                style="@style/WidgetFb.Value"
                android:layout_gravity="center"
                android:text="80"
                android:textSize="11sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/overline"
                style="@style/WidgetFb.Overline"
                android:text="Schritte" />

            <TextView
                android:id="@+id/steps"
                style="@style/WidgetFb.Number"
                android:text="6.432"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/goal"
                style="@style/WidgetFb.Muted"
                android:text="von 8.000"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
