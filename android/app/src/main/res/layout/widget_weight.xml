<?xml version="1.0" encoding="utf-8"?>
<!-- Gewicht (1×1): Tippen öffnet direkt das Eintragen -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetFb.Card"
    android:contentDescription="Gewicht eintragen">

    <ImageView android:id="@+id/glow" style="@style/WidgetFb.Glow" />

    <LinearLayout
        android:id="@+id/content"
        style="@style/WidgetFb.Content"
        android:gravity="center"
        android:padding="6dp">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_scale"
            android:tint="#E11D48" />

        <TextView
            android:id="@+id/value"
            style="@style/WidgetFb.Value"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:text="Wiegen" />
    </LinearLayout>
</FrameLayout>
