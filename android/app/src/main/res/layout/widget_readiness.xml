<?xml version="1.0" encoding="utf-8"?>
<!-- Tagesform (2×2), Buddy-Karte: Wert groß, Tipp, Kennzahlen der Uhr (nur was sie liefert) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetFb.Hero">

    <ImageView android:id="@+id/art" style="@style/WidgetFb.Art" />

    <include
        android:id="@+id/empty"
        layout="@layout/widget_empty_hero"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        style="@style/WidgetFb.HeroContent">

        <TextView
            android:id="@+id/overline"
            style="@style/WidgetFb.HeroOverline"
            android:layout_marginEnd="54dp"
            android:text="Tagesform · Mo" />

        <FrameLayout style="@style/WidgetFb.Fill" />

        <LinearLayout
            android:id="@+id/score_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/score"
                style="@style/WidgetFb.HeroNumber"
                android:text="78" />

            <TextView
                style="@style/WidgetFb.HeroBody"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="3dp"
                android:text="/ 100"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/advice"
            style="@style/WidgetFb.HeroTitle"
            android:layout_marginTop="2dp"
            android:text="Gib heute Gas"
            android:textSize="15sp" />

        <include layout="@layout/widget_hero_stats" />
    </LinearLayout>

    <include
        layout="@layout/widget_hero_buddy"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp" />
</FrameLayout>
