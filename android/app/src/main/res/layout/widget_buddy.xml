<?xml version="1.0" encoding="utf-8"?>
<!-- Buddy (2×2), Buddy-Karte: Buddy ragt oben aus der Karte, Level, Spruch, Fortschritt -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        style="@style/WidgetFb.Hero"
        android:layout_marginTop="20dp">

        <ImageView android:id="@+id/art" style="@style/WidgetFb.Art" />

        <LinearLayout style="@style/WidgetFb.HeroContent">

            <TextView
                android:id="@+id/overline"
                style="@style/WidgetFb.HeroOverline"
                android:layout_marginEnd="76dp"
                android:text="Dein Buddy" />

            <TextView
                android:id="@+id/level"
                style="@style/WidgetFb.HeroTitle"
                android:layout_marginEnd="76dp"
                android:maxLines="1"
                android:text="Level 7"
                android:textSize="20sp" />

            <FrameLayout style="@style/WidgetFb.Fill" />

            <TextView
                android:id="@+id/line"
                style="@style/WidgetFb.HeroBody"
                android:layout_width="match_parent"
                android:lineSpacingMultiplier="1.05"
                android:maxLines="3"
                android:text="Stark heute! Noch ein Glas Wasser?"
                android:textColor="@color/hero_text"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/level_bar"
                    style="@style/WidgetFb.HeroBar"
                    android:layout_width="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/level_pct"
                    style="@style/WidgetFb.HeroBody"
                    android:layout_marginStart="8dp"
                    android:fontFeatureSettings="tnum"
                    android:text="64 %"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <include
        layout="@layout/widget_hero_buddy"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="2dp" />
</FrameLayout>
