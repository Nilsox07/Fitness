<?xml version="1.0" encoding="utf-8"?>
<!-- Buddy klein (2×2): Maskottchen, Sprechblase, Level -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetFb.Card">

    <ImageView android:id="@+id/glow" style="@style/WidgetFb.Glow" />

    <LinearLayout style="@style/WidgetFb.Content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp">

                <ImageView
                    android:id="@+id/halo"
                    style="@style/WidgetFb.Ring"
                    android:src="@drawable/widget_halo_preview" />

                <ImageView
                    android:id="@+id/buddy"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:contentDescription="Buddy"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/buddy_emoji"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🐤"
                    android:textSize="28sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/overline"
                    style="@style/WidgetFb.Overline"
                    android:text="Dein Buddy" />

                <TextView
                    android:id="@+id/level"
                    style="@style/WidgetFb.Title"
                    android:maxLines="1"
                    android:text="Level 7" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="14dp"
            android:layout_height="7dp"
            android:layout_marginStart="19dp"
            android:layout_marginTop="6dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_tail_up" />

        <TextView
            android:id="@+id/line"
            style="@style/WidgetFb.Bubble"
            android:text="Stark heute! Noch ein Glas Wasser?" />

        <FrameLayout style="@style/WidgetFb.Fill" />

        <ImageView
            android:id="@+id/level_bar"
            style="@style/WidgetFb.Bar"
            android:layout_height="4dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</FrameLayout>
