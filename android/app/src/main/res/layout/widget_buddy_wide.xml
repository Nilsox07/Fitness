<?xml version="1.0" encoding="utf-8"?>
<!-- Buddy breit (4×2), Buddy-Karte: großer Buddy ragt oben rechts aus der Karte, Spruch als Überschrift -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        style="@style/WidgetFb.Hero"
        android:layout_marginTop="20dp">

        <ImageView android:id="@+id/art" style="@style/WidgetFb.Art" />

        <LinearLayout
            style="@style/WidgetFb.HeroContent"
            android:paddingEnd="136dp">

            <TextView
                android:id="@+id/overline"
                style="@style/WidgetFb.HeroOverline"
                android:text="Dein Buddy" />

            <TextView
                android:id="@+id/line"
                style="@style/WidgetFb.HeroTitle"
                android:layout_marginTop="4dp"
                android:maxLines="3"
                android:text="Stark heute! Noch ein Glas Wasser, dann passt alles."
                android:textSize="15sp" />

            <FrameLayout style="@style/WidgetFb.Fill" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/level"
                    style="@style/WidgetFb.HeroBody"
                    android:fontFeatureSettings="tnum"
                    android:text="Level 7"
                    android:textColor="@color/hero_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/level_pct"
                    style="@style/WidgetFb.HeroBody"
                    android:layout_width="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFeatureSettings="tnum"
                    android:gravity="end"
                    android:text="64 %"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/level_bar"
                style="@style/WidgetFb.HeroBar"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </FrameLayout>

    <include
        layout="@layout/widget_hero_buddy"
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="0dp"
        android:layout_marginEnd="4dp" />
</FrameLayout>
