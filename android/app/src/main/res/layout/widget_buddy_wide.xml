<?xml version="1.0" encoding="utf-8"?>
<!-- Buddy breit (4×2): großes Maskottchen links, Sprechblase rechts -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetFb.Card">

    <ImageView android:id="@+id/glow" style="@style/WidgetFb.Glow" />

    <LinearLayout
        style="@style/WidgetFb.Content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="104dp">

            <ImageView
                android:id="@+id/halo"
                style="@style/WidgetFb.Ring"
                android:src="@drawable/widget_halo_preview" />

            <ImageView
                android:id="@+id/buddy"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:contentDescription="Buddy"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/buddy_emoji"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🐤"
                android:textSize="52sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView android:id="@+id/dot" style="@style/WidgetFb.Dot" />

                <TextView
                    android:id="@+id/overline"
                    style="@style/WidgetFb.Overline"
                    android:text="Dein Buddy" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="7dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="10dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_tail_left" />

                <TextView
                    android:id="@+id/line"
                    style="@style/WidgetFb.Bubble"
                    android:textSize="13sp"
                    android:text="Stark heute! Noch ein Glas Wasser, dann passt alles." />
            </LinearLayout>

            <FrameLayout style="@style/WidgetFb.Fill" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/level"
                    style="@style/WidgetFb.Value"
                    android:text="Level 7" />

                <TextView
                    android:id="@+id/stage"
                    style="@style/WidgetFb.Muted"
                    android:layout_width="0dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Küken" />

                <TextView
                    android:id="@+id/level_pct"
                    style="@style/WidgetFb.Muted"
                    android:fontFeatureSettings="tnum"
                    android:text="64 %" />
            </LinearLayout>

            <ImageView
                android:id="@+id/level_bar"
                style="@style/WidgetFb.Bar"
                android:layout_height="5dp"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
