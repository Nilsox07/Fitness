<?xml version="1.0" encoding="utf-8"?>
<!-- Supplemente (2×2): als Nächstes, Uhrzeit, Fortschritt -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetFb.Card">

    <ImageView android:id="@+id/glow" style="@style/WidgetFb.Glow" />

    <include
        android:id="@+id/empty"
        layout="@layout/widget_empty"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        style="@style/WidgetFb.Content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView android:id="@+id/dot" style="@style/WidgetFb.Dot" />

            <TextView
                android:id="@+id/overline"
                style="@style/WidgetFb.Overline"
                android:text="Supplemente" />
        </LinearLayout>

        <TextView
            android:id="@+id/next_label"
            style="@style/WidgetFb.Muted"
            android:layout_marginTop="8dp"
            android:text="Als Nächstes" />

        <TextView
            android:id="@+id/name"
            style="@style/WidgetFb.Title"
            android:layout_marginTop="1dp"
            android:text="Vitamin D3" />

        <TextView
            android:id="@+id/time"
            style="@style/WidgetFb.Value"
            android:layout_marginTop="2dp"
            android:text="um 08:00 Uhr"
            android:textColor="#E11D48" />

        <FrameLayout style="@style/WidgetFb.Fill" />

        <ImageView
            android:id="@+id/dots"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:importantForAccessibility="no"
            android:scaleType="fitStart"
            android:src="@drawable/widget_dots_preview" />

        <TextView
            android:id="@+id/progress"
            style="@style/WidgetFb.Muted"
            android:layout_marginTop="5dp"
            android:text="2 von 3 genommen" />
    </LinearLayout>
</FrameLayout>
