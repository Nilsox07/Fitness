<?xml version="1.0" encoding="utf-8"?>
<!-- Schritte (2×2), Buddy-Karte: Zahl groß, Balken gegen das Ziel, Siegel bei Ziel erreicht -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetFb.Hero">

    <ImageView android:id="@+id/art" style="@style/WidgetFb.Art" />

    <include
        android:id="@+id/empty"
        layout="@layout/widget_empty_hero"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        style="@style/WidgetFb.HeroContent">

        <TextView
            android:id="@+id/overline"
            style="@style/WidgetFb.HeroOverline"
            android:layout_marginEnd="54dp"
            android:text="Schritte · Mo" />

        <FrameLayout style="@style/WidgetFb.Fill" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/steps"
                style="@style/WidgetFb.HeroNumber"
                android:text="6.432" />

            <TextView
                android:id="@+id/goal"
                style="@style/WidgetFb.HeroBody"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="3dp"
                android:text="von 8.000"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/bar"
            style="@style/WidgetFb.HeroBar"
            android:layout_marginTop="8dp" />

        <include layout="@layout/widget_hero_stats" />
    </LinearLayout>

    <include
        layout="@layout/widget_hero_buddy"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp" />

    <ImageView android:id="@+id/seal" style="@style/WidgetFb.Seal" />
</FrameLayout>
