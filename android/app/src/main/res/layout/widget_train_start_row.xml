<?xml version="1.0" encoding="utf-8"?>
<!-- Training starten (2×1): Name links, runder Start-Knopf rechts -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetFb.Hero">

    <ImageView android:id="@+id/art" style="@style/WidgetFb.Art" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/overline"
                style="@style/WidgetFb.HeroOverline"
                android:text="Training" />

            <TextView
                android:id="@+id/title"
                style="@style/WidgetFb.HeroTitle"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="Oberkörper A"
                android:textSize="15sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_action_primary"
            android:contentDescription="Training starten">

            <ImageView
                android:id="@+id/btn_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_play"
                android:tint="#9F1239" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
