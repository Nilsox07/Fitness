<?xml version="1.0" encoding="utf-8"?>
<!-- Training (2×2), Buddy-Karte: nächstes Training, Wochenziel, Serie (Siegel ab 2 Wochen) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetFb.Hero">

    <ImageView android:id="@+id/art" style="@style/WidgetFb.Art" />

    <include
        android:id="@+id/empty"
        layout="@layout/widget_empty_hero"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        style="@style/WidgetFb.HeroContent">

        <TextView
            android:id="@+id/overline"
            style="@style/WidgetFb.HeroOverline"
            android:layout_marginEnd="54dp"
            android:text="Training · Mo" />

        <FrameLayout style="@style/WidgetFb.Fill" />

        <TextView
            android:id="@+id/next"
            style="@style/WidgetFb.HeroTitle"
            android:text="Oberkörper A" />

        <TextView
            android:id="@+id/week"
            style="@style/WidgetFb.HeroBody"
            android:layout_marginTop="2dp"
            android:text="Noch 1 Einheit diese Woche" />

        <include layout="@layout/widget_hero_stats" />
    </LinearLayout>

    <include
        layout="@layout/widget_hero_buddy"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp" />

    <ImageView android:id="@+id/seal" style="@style/WidgetFb.Seal" />
</FrameLayout>
