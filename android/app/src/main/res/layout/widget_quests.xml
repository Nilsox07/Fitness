<?xml version="1.0" encoding="utf-8"?>
<!-- Quests (2×2), Buddy-Karte: erledigt/gesamt, Punkte, Level; Siegel wenn alle geschafft -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetFb.Hero">

    <ImageView android:id="@+id/art" style="@style/WidgetFb.Art" />

    <include
        android:id="@+id/empty"
        layout="@layout/widget_empty_hero"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        style="@style/WidgetFb.HeroContent">

        <TextView
            android:id="@+id/overline"
            style="@style/WidgetFb.HeroOverline"
            android:layout_marginEnd="54dp"
            android:text="Quests · Mo" />

        <FrameLayout style="@style/WidgetFb.Fill" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/done"
                style="@style/WidgetFb.HeroNumber"
                android:text="2" />

            <TextView
                android:id="@+id/total"
                style="@style/WidgetFb.HeroBody"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="3dp"
                android:text="/ 3"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/hint"
            style="@style/WidgetFb.HeroBody"
            android:layout_width="match_parent"
            android:text="Noch 1 Quest offen" />

        <ImageView
            android:id="@+id/dots"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitStart"
            android:src="@drawable/widget_hero_dots_preview" />

        <include layout="@layout/widget_hero_stats" />
    </LinearLayout>

    <include
        layout="@layout/widget_hero_buddy"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp" />

    <ImageView android:id="@+id/seal" style="@style/WidgetFb.Seal" />
</FrameLayout>
