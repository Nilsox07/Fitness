<?xml version="1.0" encoding="utf-8"?>
<!-- Quests (2×2): erledigt/gesamt, Punkte, Level -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetFb.Card">

    <ImageView android:id="@+id/glow" style="@style/WidgetFb.Glow" />

    <include
        android:id="@+id/empty"
        layout="@layout/widget_empty"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        style="@style/WidgetFb.Content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView android:id="@+id/dot" style="@style/WidgetFb.Dot" />

            <TextView
                android:id="@+id/overline"
                style="@style/WidgetFb.Overline"
                android:text="Tagesquests" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/done"
                style="@style/WidgetFb.Number"
                android:text="2"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/total"
                style="@style/WidgetFb.Muted"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="3dp"
                android:text="/ 3"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/hint"
            style="@style/WidgetFb.Body"
            android:layout_width="match_parent"
            android:layout_marginTop="2dp"
            android:text="Noch 1 Quest offen" />

        <FrameLayout style="@style/WidgetFb.Fill" />

        <ImageView
            android:id="@+id/dots"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:importantForAccessibility="no"
            android:scaleType="fitStart"
            android:src="@drawable/widget_dots_preview" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/level"
                style="@style/WidgetFb.Muted"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Level 7" />

            <TextView
                android:id="@+id/level_pct"
                style="@style/WidgetFb.Muted"
                android:fontFeatureSettings="tnum"
                android:text="64 %" />
        </LinearLayout>

        <ImageView
            android:id="@+id/level_bar"
            style="@style/WidgetFb.Bar"
            android:layout_height="4dp"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</FrameLayout>
