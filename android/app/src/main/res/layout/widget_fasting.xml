<?xml version="1.0" encoding="utf-8"?>
<!-- Fasten (2×2): Phase, Live-Countdown, Ring -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetFb.Card">

    <ImageView android:id="@+id/glow" style="@style/WidgetFb.Glow" />

    <include
        android:id="@+id/empty"
        layout="@layout/widget_empty"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        style="@style/WidgetFb.Content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView android:id="@+id/dot" style="@style/WidgetFb.Dot" />

                    <TextView
                        android:id="@+id/overline"
                        style="@style/WidgetFb.Overline"
                        android:text="Fasten" />
                </LinearLayout>

                <TextView
                    android:id="@+id/phase"
                    style="@style/WidgetFb.Title"
                    android:layout_marginTop="4dp"
                    android:text="Fastenzeit"
                    android:textSize="15sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp">

                <ImageView android:id="@+id/ring" style="@style/WidgetFb.Ring" />

                <TextView
                    android:id="@+id/pct"
                    style="@style/WidgetFb.Value"
                    android:layout_gravity="center"
                    android:text="62"
                    android:textSize="11sp" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout style="@style/WidgetFb.Fill" />

        <Chronometer
            android:id="@+id/countdown"
            style="@style/WidgetFb.Number"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:autoSizeMaxTextSize="30sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeTextType="uniform"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/done"
            style="@style/WidgetFb.Number"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeTextType="uniform"
            android:gravity="center_vertical"
            android:textColor="@color/widget_success"
            android:visibility="gone" />

        <TextView
            android:id="@+id/until"
            style="@style/WidgetFb.Muted"
            android:layout_marginTop="2dp"
            android:text="noch · bis 12:00 Uhr" />
    </LinearLayout>
</FrameLayout>
