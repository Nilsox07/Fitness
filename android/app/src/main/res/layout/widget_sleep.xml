<?xml version="1.0" encoding="utf-8"?>
<!-- Schlaf (2×2): letzte Nacht groß, Balken gegen 8 h -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    style="@style/WidgetFb.Card">

    <ImageView android:id="@+id/glow" style="@style/WidgetFb.Glow" />

    <include
        android:id="@+id/empty"
        layout="@layout/widget_empty"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        style="@style/WidgetFb.Content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView android:id="@+id/dot" style="@style/WidgetFb.Dot" />

            <TextView
                android:id="@+id/overline"
                style="@style/WidgetFb.Overline"
                android:text="Letzte Nacht" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/duration"
                style="@style/WidgetFb.Number"
                android:text="7:24"
                android:textSize="34sp" />

            <TextView
                style="@style/WidgetFb.Muted"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="3dp"
                android:text="Std."
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/hint"
            style="@style/WidgetFb.Body"
            android:layout_width="match_parent"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:text="Gut ausgeschlafen" />

        <FrameLayout style="@style/WidgetFb.Fill" />

        <ImageView
            android:id="@+id/bar"
            style="@style/WidgetFb.Bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/extra"
                style="@style/WidgetFb.Muted"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="Tagesform 78" />

            <TextView
                style="@style/WidgetFb.Muted"
                android:text="Ziel 8 h" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
