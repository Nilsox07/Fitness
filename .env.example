# Supabase Zugangsdaten — findest du im Supabase-Dashboard unter:
# Project Settings -> API
VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-public-key

# -------------------------------------------------------------------
# SERVERSEITIGE Secrets — NICHT hier / nicht ins Git eintragen!
# Diese gehoeren ausschliesslich in die Vercel-Projekt-Umgebungsvariablen
# (Vercel -> Settings -> Environment Variables). Sie werden nur von den
# Serverless-Funktionen unter /api gelesen und nie an den Browser ausgeliefert.
#
#   GEMINI_API_KEY   = <dein Google-Gemini-API-Key>   (Pflicht fuer KI)
#   AI_PROVIDER      = gemini                          (optional, Standard)
#   GEMINI_MODEL     = gemini-flash-latest             (optional)
#
# Optional (nur falls genutzt):
#   VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT   (Push)
#   SUPABASE_SERVICE_ROLE_KEY                              (Push/Fitbit-Server)
#   FITBIT_CLIENT_ID / FITBIT_CLIENT_SECRET               (Fitbit)
# -------------------------------------------------------------------
